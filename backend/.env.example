# =============================================================================
# SERVE backend — environment template
# =============================================================================
# Copy to backend/.env (development) and backend/.env.test (tests); both are
# gitignored. Fill in YOUR OWN values: generate your own secrets and use your
# own Google OAuth client. Never commit a filled-in copy, never paste secrets
# into chat, and never reuse another developer's secrets.
#
# Production loads no file: the hosting platform injects variables
# (template: deploy/production.env.example). Every variable is validated at
# startup (backend/src/config/env.ts); errors name the variable, never its value.
# =============================================================================

# development | test | production
NODE_ENV=development

# Never 5000 (macOS AirPlay Receiver).
PORT=5001

# Create the local role and databases first:
#   SERVE_DB_PASSWORD='<choose-a-password>' npm run db:setup:local
# development: serve_dev   test: serve_test (recreated by every test run)
DATABASE_URL=postgresql://serve:<db-password>@localhost:5432/serve_dev?schema=public

# Exact browser origins allowed to call the API and Socket.IO (comma-separated,
# no trailing slash): staff dashboard, admin portal, student app on the web.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5555

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Sign-in: Better Auth (role-specific) -----------------------------------
#   Students        Google only, verified @srmap.edu.in accounts
#   Staff, admins   email + password only (staff: any address; admins:
#                   @srmap.edu.in, created with npm run admin:create)
# Public URL of this backend as browsers reach it. Use localhost (not
# 127.0.0.1) locally. Your Google OAuth client must list
#   <BETTER_AUTH_URL>/api/auth/callback/google
# as an authorized redirect URI.
BETTER_AUTH_URL=http://localhost:5001

# Required except under NODE_ENV=test. At least 32 characters. Generate your
# own: openssl rand -base64 32   (PowerShell: see docs/development.md)
BETTER_AUTH_SECRET=

# Your own Google OAuth web client (Google Cloud console -> Google Auth
# Platform -> Clients). Used for STUDENT sign-in only. Set both or neither;
# without them the backend starts, staff/admin password sign-in works, but
# student Google sign-in is unavailable. Authorized JavaScript origin:
#   http://localhost:5555
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true (default): also require Google's hosted-domain claim hd=srmap.edu.in.
# The verified @srmap.edu.in email check applies either way.
# GOOGLE_REQUIRE_HOSTED_DOMAIN=true

# Public app URLs, trusted as sign-in return addresses (no trailing slash).
# Development defaults to these ports when unset; production requires https.
STUDENT_APP_URL=http://localhost:5555
STAFF_DASHBOARD_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174

# --- Payments ----------------------------------------------------------------
# mock (development/test; production only with DEMO_MODE=true) | razorpay
PAYMENT_MODE=mock
# Required when PAYMENT_MODE=mock. At least 32 characters. Generate your own:
# openssl rand -hex 32
PAYMENT_SECRET=
# true = public demo deployment (mock payments with NODE_ENV=production).
# DEMO_MODE=false
# Required only when PAYMENT_MODE=razorpay (Razorpay API calls are pending).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Optional ----------------------------------------------------------------
# Reverse-proxy hops to trust for client IPs (0 locally; 1 behind one proxy).
# TRUST_PROXY=0
# Folder of built web apps (npm run build:web -> dist/web) to serve on one
# domain. Unset locally: the API alone.
# WEB_ROOT=
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
# SENSITIVE_RATE_LIMIT_MAX=20

# --- Script-only (read by scripts, not the server) ---------------------------
# Passwords are always typed at a hidden prompt (or piped on stdin), never
# stored here or passed as arguments.
# npm run admin:create --workspace backend -- --email <you>@srmap.edu.in --name "<name>"
# npm run account:set-password --workspace backend -- --role staff|admin --email <address>
# npm run db:seed:dev-users --workspace backend  (development only) uses:
# DEV_ADMIN_EMAIL=          (@srmap.edu.in; password sign-in)
# DEV_STAFF_NIGHT_EMAIL=    (any address; password sign-in)
# DEV_STAFF_DAY_EMAIL=
# DEV_STAFF_PENDING_EMAIL=
# DEV_STUDENT_EMAIL=        (your @srmap.edu.in Google account)

# =============================================================================
# TEST notes — for backend/.env.test change only these:
#   NODE_ENV=test
#   DATABASE_URL=postgresql://serve:<db-password>@localhost:5432/serve_test?schema=public
#   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET: leave empty
#     (tests never contact Google; they use a test-only sign-in that the test
#     harness enables itself)
#   PORT=5101 (keeps tests off the development port)
#   PAYMENT_SECRET: a different 32+ character value of your own
#   LOG_LEVEL=silent
#   RATE_LIMIT_MAX=100000 and SENSITIVE_RATE_LIMIT_MAX=100000 (the suites make
#     many requests from one client)
# Never set AUTH_TEST_SIGN_IN outside NODE_ENV=test: the server refuses to start.
# =============================================================================
