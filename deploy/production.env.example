# SERVE — production / public demo backend environment (TEMPLATE).
#
# Copy to your host's secret manager or environment settings. Never commit the
# filled-in copy, never reuse development values, never put these in frontend
# builds. Placeholders are in <angle brackets>. See docs/deployment.md.

NODE_ENV=production
PORT=5001

# PostgreSQL (managed or self-hosted). Use TLS if the database is remote,
# e.g. append &sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# The one public origin. No trailing slash, https only.
CORS_ORIGINS=https://YOUR_DOMAIN

# Number of reverse proxies in front of the backend (Caddy/nginx/load balancer).
TRUST_PROXY=1

# Built web apps (output of `npm run build:web`): student/, staff/, admin/.
WEB_ROOT=<absolute path, e.g. /srv/serve/web>

LOG_LEVEL=info

# Firebase (a real project; demo- projects and the emulator are rejected).
FIREBASE_PROJECT_ID=<firebase project id>
# Service account: Firebase console → Project settings → Service accounts.
FIREBASE_CLIENT_EMAIL=<service account email>
# The private key on one line with \n for newlines, inside quotes if your
# platform needs them.
FIREBASE_PRIVATE_KEY=<private key>

# Optional: only these email domains may register as students.
# STUDENT_EMAIL_DOMAINS=<university.edu>

# Payments — PUBLIC DEMO: simulated, no real money. Both lines are required
# together; production refuses PAYMENT_MODE=mock without DEMO_MODE=true.
PAYMENT_MODE=mock
DEMO_MODE=true
# New random value for this deployment (openssl rand -hex 32). Not the dev one.
PAYMENT_SECRET=<64 hex characters>

# Rate limits (defaults shown).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
# SENSITIVE_RATE_LIMIT_MAX=20
