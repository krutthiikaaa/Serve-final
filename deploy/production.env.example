# SERVE — production / public demo backend environment (TEMPLATE).
#
# Copy to your host's secret manager or environment settings. Never commit the
# filled-in copy, never reuse development values, never put these in frontend
# builds. Placeholders are in <angle brackets>. See docs/deployment.md.

NODE_ENV=production
PORT=5001

# PostgreSQL (managed or self-hosted). Use TLS if the database is remote,
# e.g. append &sslmode=require.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# The one public origin. No trailing slash, https only.
CORS_ORIGINS=https://YOUR_DOMAIN

# Public app URLs, trusted as sign-in return addresses (no trailing slash).
# Single-domain demo:
STUDENT_APP_URL=https://YOUR_DOMAIN
STAFF_DASHBOARD_URL=https://YOUR_DOMAIN/staff
ADMIN_PORTAL_URL=https://YOUR_DOMAIN/admin

# Number of reverse proxies in front of the backend (Caddy/nginx/load balancer).
TRUST_PROXY=1

# Built web apps (output of `npm run build:web`): student/, staff/, admin/.
WEB_ROOT=<absolute path, e.g. /srv/serve/web>

LOG_LEVEL=info

# Sign-in: Google via Better Auth. Only verified @srmap.edu.in accounts.
# Public base URL of this backend. The Google OAuth client must list
# <BETTER_AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
BETTER_AUTH_URL=https://YOUR_DOMAIN
# New random value for this deployment (openssl rand -base64 32).
BETTER_AUTH_SECRET=<secret>
# Google Auth Platform → Clients → your Web client.
GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client secret>
# Also require Google's hosted-domain claim (SRM Google Workspace). Default true.
# GOOGLE_REQUIRE_HOSTED_DOMAIN=true

# Payments — PUBLIC DEMO: simulated, no real money. Both lines are required
# together; production refuses PAYMENT_MODE=mock without DEMO_MODE=true.
PAYMENT_MODE=mock
DEMO_MODE=true
# New random value for this deployment (openssl rand -hex 32). Not the dev one.
PAYMENT_SECRET=<64 hex characters>

# Rate limits (defaults shown).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
# SENSITIVE_RATE_LIMIT_MAX=20
