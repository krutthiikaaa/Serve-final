# Only sources go into the build: the image builds the backend and all three
# web apps itself. Never send secrets, local state or build output.
.git
**/node_modules
**/.env
**/.env.*
!**/.env.example
deploy/*.env
**/*.pem
**/*.key
**/*.jks
**/*.keystore
**/key.properties
**/*service-account*.json
**/*serviceAccount*.json
**/*-firebase-adminsdk-*.json
backend/dist
backend/src/generated
backend/coverage
apps/*/dist
apps/student/build
apps/student/ios/Pods
apps/student/ios/.symlinks
apps/student/android/.gradle
apps/student/.flutter-plugins*
apps/student/config/*.json
!apps/student/config/*.example.json
**/.dart_tool
e2e/test-results
e2e/playwright-report*
dist
*.log
