# =============================================================================
# SERVE — environment variable reference
# =============================================================================
# Copy the relevant section into each app's own env file. Real env files are
# gitignored. NEVER commit real values: passwords, private keys, service
# account JSON, payment secrets.
#
# Environments:
#   development -> backend/.env         (loaded automatically)
#   test        -> backend/.env.test    (loaded automatically by `npm test`)
#   production  -> NO file is loaded; the hosting platform / secrets manager
#                  injects variables. Validation refuses localhost origins,
#                  plain-http origins and the Firebase emulator in production.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND  (backend/.env, backend/.env.test)
# -----------------------------------------------------------------------------
NODE_ENV=development

# Never 5000 (macOS AirPlay Receiver). Rejected by validation.
PORT=5001

# PostgreSQL. Create local DBs with: SERVE_DB_PASSWORD=... npm run db:setup:local
# development: serve_dev   test: serve_test
DATABASE_URL=postgresql://serve:<password>@localhost:5432/serve_dev?schema=public

# Exact origins allowed to call the API from a browser (comma-separated,
# no trailing slash). Production must use https and non-local hosts.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Reverse-proxy hops to trust for client IPs (0 locally; 1 behind one ALB).
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# API rate limit per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Firebase Admin SDK (Phase 3). From a service account — paste values, never
# commit the JSON file. Required in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; literal \n sequences are converted to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Auth Emulator (development/test only; forbidden in production).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Payments: mock (now) | razorpay (later).
PAYMENT_MODE=mock
# HMAC secret for payment verification, >= 32 chars: openssl rand -hex 32
PAYMENT_SECRET=


# -----------------------------------------------------------------------------
# STAFF DASHBOARD  (staff-dashboard/.env.local)  — Phase 6
# ADMIN PORTAL     (admin-portal/.env.local)     — Phase 7
# -----------------------------------------------------------------------------
# Public values only (bundled into the browser). Production builds fail if
# the API URL is missing — there is no localhost fallback.
# VITE_API_URL=http://localhost:5001
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099


# -----------------------------------------------------------------------------
# STUDENT APP  (Flutter --dart-define / --dart-define-from-file)  — Phase 5
# -----------------------------------------------------------------------------
# API_URL=http://localhost:5001
# STAFF_DASHBOARD_URL=http://localhost:5173
# ADMIN_PORTAL_URL=http://localhost:5174
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
