# =============================================================================
# SERVE — environment variable reference
# =============================================================================
# Copy the relevant section into each app's own env file. Real env files are
# gitignored. NEVER commit real values: passwords, private keys, service
# account JSON, payment secrets.
#
# Environments:
#   development -> backend/.env         (loaded automatically)
#   test        -> backend/.env.test    (loaded automatically by `npm test`)
#   production  -> NO file is loaded; the hosting platform / secrets manager
#                  injects variables. Validation refuses localhost or http CORS
#                  origins, a localhost or http BETTER_AUTH_URL, missing Google
#                  credentials, the test-only sign-in and the mock payment
#                  provider in production (unless DEMO_MODE=true declares a
#                  public demo). Template: deploy/production.env.example
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND  (backend/.env, backend/.env.test)
# Ready-to-copy template with test notes: backend/.env.example
# -----------------------------------------------------------------------------
NODE_ENV=development

# Never 5000 (macOS AirPlay Receiver). Rejected by validation.
PORT=5001

# PostgreSQL. Create local DBs with: SERVE_DB_PASSWORD=... npm run db:setup:local
# development: serve_dev   test: serve_test (recreated by every test run)
DATABASE_URL=postgresql://serve:<password>@localhost:5432/serve_dev?schema=public

# Exact origins allowed to call the API/Socket.IO from a browser
# (comma-separated, no trailing slash). Production: https only, no localhost.
# 5173 = staff dashboard, 5174 = admin portal, 5555 = student app on the web
# (npm run dev:student). Flutter on Android/iOS sends no Origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5555

# Reverse-proxy hops to trust for client IPs (0 locally; 1 behind one ALB).
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Single-domain deployment only: folder with the built web apps
# (npm run build:web → dist/web). Unset locally: the API alone.
# WEB_ROOT=

# Global API rate limit per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter per-user limit: registration, order creation, payments, webhooks.
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
SENSITIVE_RATE_LIMIT_MAX=20

# --- Sign-in (Better Auth, role-specific) ------------------------------------
# Students: Google only (verified @srmap.edu.in). Staff: email + password (any
# address; PENDING until an admin approves). Admins: email + password
# (@srmap.edu.in, provisioned with admin:create). Secrets stay in
# backend/.env: never in an app's env file.
# Public base URL of this backend. The Google OAuth client must list
# <BETTER_AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
BETTER_AUTH_URL=http://localhost:5001
# Required (except tests): openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Auth Platform → Clients → Web client (student sign-in only).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Authorized JavaScript origin: http://localhost:5555.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Also require Google's hosted-domain claim (SRM Google Workspace). Default true.
# GOOGLE_REQUIRE_HOSTED_DOMAIN=true
# Test-only sign-in endpoint for automated tests. Refused unless NODE_ENV=test.
# AUTH_TEST_SIGN_IN=false
# Public app URLs, trusted as sign-in return addresses (no trailing slash).
# Development defaults to these ports when unset. Production requires https.
STUDENT_APP_URL=http://localhost:5555
STAFF_DASHBOARD_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174
# --- Payments ----------------------------------------------------------------
# mock (development/test; production only with DEMO_MODE=true) |
# razorpay (production; API calls pending)
PAYMENT_MODE=mock
# true = public demo deployment: mock payments allowed with NODE_ENV=production,
# no real money moves. Every other production rule still applies.
# DEMO_MODE=false
# Mock provider HMAC secret, >= 32 chars: openssl rand -hex 32
PAYMENT_SECRET=
# Required when PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Script-only variables (not read by the server) ---------------------------
# npm run admin:create -- --email <name>@srmap.edu.in --name "<name>"
#   (asks for the admin's password at a hidden prompt)
# npm run account:set-password -- --role staff|admin --email <address>
#   (set or reset a staff/admin password; ends that account's sessions)
# npm run db:seed:dev-users (development accounts; asks for one password for
#   the staff/admin accounts; the student signs in with Google)
# DEV_ADMIN_EMAIL=
# DEV_STAFF_NIGHT_EMAIL=
# DEV_STAFF_DAY_EMAIL=
# DEV_STAFF_PENDING_EMAIL=
# DEV_STUDENT_EMAIL=


# -----------------------------------------------------------------------------
# STAFF DASHBOARD  (apps/staff/.env.development.local)
# ADMIN PORTAL     (apps/admin/.env.development.local)
# -----------------------------------------------------------------------------
# Public values only (bundled into the browser). Development requires
# VITE_API_URL. Production builds (npm run build:web) call the origin that
# serves them unless VITE_API_URL is set (https only). Sign-in (email +
# password) needs no frontend configuration: it is entirely on the backend.
# VITE_API_URL=http://localhost:5001
# Optional: link to the student app.
# VITE_STUDENT_APP_URL=http://localhost:5555


# -----------------------------------------------------------------------------
# STUDENT APP  (Flutter --dart-define; see apps/student/README.md)
# -----------------------------------------------------------------------------
# Development defaults need none of these. A built web app defaults to the
# origin that serves it (API, /staff/, /admin/); mobile release builds need
# API_URL=https://YOUR_DOMAIN. Native sign-in returns on app.serve.student://auth.
# API_URL=http://localhost:5001
# STAFF_DASHBOARD_URL=http://localhost:5173
# ADMIN_PORTAL_URL=http://localhost:5174
