# =============================================================================
# SERVE — environment variable reference
# =============================================================================
# Copy the relevant section into each app's own env file. Real env files are
# gitignored. NEVER commit real values: passwords, private keys, service
# account JSON, payment secrets.
#
# Environments:
#   development -> backend/.env         (loaded automatically)
#   test        -> backend/.env.test    (loaded automatically by `npm test`)
#   production  -> NO file is loaded; the hosting platform / secrets manager
#                  injects variables. Validation refuses localhost or http CORS
#                  origins, the Firebase emulator, demo- Firebase projects and
#                  the mock payment provider in production (unless DEMO_MODE=true
#                  declares a public demo). Template: deploy/production.env.example
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND  (backend/.env, backend/.env.test)
# -----------------------------------------------------------------------------
NODE_ENV=development

# Never 5000 (macOS AirPlay Receiver). Rejected by validation.
PORT=5001

# PostgreSQL. Create local DBs with: SERVE_DB_PASSWORD=... npm run db:setup:local
# development: serve_dev   test: serve_test (recreated by every test run)
DATABASE_URL=postgresql://serve:<password>@localhost:5432/serve_dev?schema=public

# Exact origins allowed to call the API/Socket.IO from a browser
# (comma-separated, no trailing slash). Production: https only, no localhost.
# 5173 = staff dashboard, 5174 = admin portal, 5555 = student app on the web
# (npm run dev:student). Flutter on Android/iOS sends no Origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5555

# Reverse-proxy hops to trust for client IPs (0 locally; 1 behind one ALB).
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Single-domain deployment only: folder with the built web apps
# (npm run build:web → dist/web). Unset locally: the API alone.
# WEB_ROOT=

# Global API rate limit per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter per-user limit: registration, order creation, payments, webhooks.
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
SENSITIVE_RATE_LIMIT_MAX=20

# --- Firebase ----------------------------------------------------------------
# Development/test: the Auth Emulator with a demo- project (no credentials).
FIREBASE_PROJECT_ID=demo-serve
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Real project (production): remove FIREBASE_AUTH_EMULATOR_HOST and set the
# service-account values. Paste values — never commit the JSON file.
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; literal \n sequences are converted to newlines.
FIREBASE_PRIVATE_KEY=

# Optional: restrict student registration to these email domains
# (comma-separated, e.g. "university.edu"). Empty = no restriction.
STUDENT_EMAIL_DOMAINS=

# --- Payments ----------------------------------------------------------------
# mock (development/test; production only with DEMO_MODE=true) |
# razorpay (production; API calls pending)
PAYMENT_MODE=mock
# true = public demo deployment: mock payments allowed with NODE_ENV=production,
# no real money moves. Every other production rule still applies.
# DEMO_MODE=false
# Mock provider HMAC secret, >= 32 chars: openssl rand -hex 32
PAYMENT_SECRET=
# Required when PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Script-only variables (not read by the server) ---------------------------
# npm run admin:create      (development: password for a newly created Firebase user)
# ADMIN_BOOTSTRAP_PASSWORD=
# npm run db:seed:dev-users (emulator demo accounts)
# DEV_SEED_PASSWORD=


# -----------------------------------------------------------------------------
# STAFF DASHBOARD  (apps/staff/.env.development.local)
# ADMIN PORTAL     (apps/admin/.env.development.local)
# -----------------------------------------------------------------------------
# Public values only (bundled into the browser). Development requires
# VITE_API_URL. Production builds (npm run build:web) call the origin that
# serves them unless VITE_API_URL is set (https only), and refuse the emulator.
# VITE_API_URL=http://localhost:5001
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=demo-serve
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099


# -----------------------------------------------------------------------------
# STUDENT APP  (Flutter --dart-define; see apps/student/README.md)
# -----------------------------------------------------------------------------
# Development defaults need none of these. A built web app defaults to the
# origin that serves it (API, /staff/, /admin/); mobile release builds need
# API_URL=https://YOUR_DOMAIN and the real Firebase values.
# API_URL=http://localhost:5001
# STAFF_DASHBOARD_URL=http://localhost:5173
# ADMIN_PORTAL_URL=http://localhost:5174
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
